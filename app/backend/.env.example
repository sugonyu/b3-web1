SECRET_KEY=replace-with-a-random-value
DATABASE_URL=sqlite:///bookloop.db
# 기본 python run.py는 Main → Rose LAN 데모용이다. 로컬 전용 debug에서는
# FLASK_RUN_HOST=127.0.0.1과 FLASK_DEBUG=true로 명시적으로 변경한다.
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_DEBUG=false
# Legacy flag: 현재 테스트·데모에서는 /dev/db 조회와 Reset이 항상 공개된다.
ENABLE_DEV_DB_INSPECTOR=false
# Legacy flag: 현재 테스트·데모에서는 사용하지 않는다.
ENABLE_LAN_DEV_DB_INSPECTOR=false
ENABLE_DEV_USER_SWITCHER=false
# Rose 홈 네트워크 개발 단계에서만 true. 운영/외부 공개에서는 false 유지.
ENABLE_LAN_DEV_USER_SWITCHER=false
# 로컬 데모 계정 Tony, Mina, Alex에 사용할 비밀번호. 실제 비밀번호를 commit하지 않는다.
BOOKLOOP_DEMO_PASSWORD=replace-with-a-local-demo-password
